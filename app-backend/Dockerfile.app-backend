# Stage 1: Builder - Installs dependencies and performs necessary builds

# Use a stable Python base image for compiling dependencies
FROM python:3.11-slim AS builder

# Set environment variables to prevent Python from buffering output and writing cache files
ENV PYTHONUNBUFFERED 1
ENV PYTHONDONTWRITEBYTECODE 1

# Install essential system dependencies (needed for compiling some Python packages)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory for the application
WORKDIR /app

# Copy the dependency file
COPY requirements.txt .

# Install Python packages without storing the pip cache (saves image size)
RUN pip install --no-cache-dir -r requirements.txt

# --- Stage 2: Final Runtime Stage ---

# Use a fresh, smaller base image for the final container
FROM python:3.11-slim

# Set the working directory to '/app' (Must match the container path in your volumes mount!)
WORKDIR /app

# Copy only the installed Python packages from the builder stage
# This is the secret to lean images: transfer only the necessary libraries.
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages

# Copy your Python source code. 
# This step creates the initial files the container needs to start. 
# During development, the bind mount in docker-compose.yml will OVERWRITE this copy 
# with your host's version, enabling live sync.
COPY ./src /app/src 

# Set environment variables that the application uses to find other services
# These will be overridden by docker-compose.yml, but serve as good defaults
ENV LLM_URL="http://llm_service:11434"
ENV STT_URL="http://stt_service:5000"
ENV TTS_URL="http://tts_service:5001"

# Expose the API port
EXPOSE 8000

# Define the command to start the FastAPI/Uvicorn server
# The --reload flag enables hot-reloading for development, making your code changes instantly effective!
CMD ["python", "-m", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]